# Copy thành .env (make env) rồi điền giá trị. File .env KHÔNG được commit.
# Secret của OAuth client "backoffice", phải giống OAUTH_CLIENT_SECRET bên backoffice.
OAUTH_BACKOFFICE_CLIENT_SECRET=change-me
# Tuỳ chọn: ghi đè config.yml
# REST_SERVER_ADDR=:9000
# OAUTH_TOKEN_TTL=900
# AUTHZ_SERVICE_ADDR=localhost:50052
# Postgres local (make db / make up). DB_PASSWORD dùng cho container, DB_URL cho service chạy bằng go run.
DB_PASSWORD=change-me
DB_URL=postgres://auth:change-me@localhost:54321/auth_db?sslmode=disable
